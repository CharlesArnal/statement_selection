\[
\Bigg(\frac{\mu^{3/2}r\sqrt{\log n}}{n^{3/2}p}+\sqrt{\frac{\mu^{2}r\log n}{n^{2}p}}+\frac{\mu r}{n}\Bigg)\nu_{\max}^{2}\leq\nu_{\min}^{2}\quad\rightarrow\quad\Bigg(\frac{\mu^{3/2}\kappa^{2}r\sqrt{\log n}}{n^{3/2}p}+\sqrt{\frac{\mu^{2}\kappa^{4}r\log n}{n^{2}p}}+\frac{\mu r\kappa^{2}}{n}\Bigg)\leq1
\]

\end_inset


\begin_inset Formula 
\[
p\geq\frac{\mu^{3/2}\kappa^{2}r\sqrt{\log n}}{n^{3/2}}\quad p\geq\frac{\mu^{2}\kappa^{4}r\log n}{n^{2}}\quad\mu r\kappa^{2}\leq n
\]

\end_inset


\begin_inset Formula 
\[
p\geq c_{5}\max\Bigg\{\frac{\mu^{3/2}\kappa^{2}r\sqrt{\log n}}{n^{3/2}},\frac{\mu^{2}\kappa^{4}r\log n}{n^{2}}\Bigg\}
\]

