\begin_layout Standard
Let 
\begin_inset Formula $\bm{Q}_{i}\coloneqq\mathcal{P}_{\mathsf{off}\text{-}\mathsf{diag}}\big(\bm{A}_{\cdot,i}^{\star}\big(\bm{Z}_{\cdot,i}\big)^{\top}\big)$
\end_inset

.
 Observe that
\begin_inset Formula 
\[
\mathbb{E}\big[\bm{Q}_{i}\bm{Q}_{i}^{\top}\big]=\mathbb{E}\bm{A}_{\cdot,i}^{\star}\big(\bm{Z}_{\cdot,i}\big)^{\top}\big(\bm{Z}_{\cdot,i}\big)\bm{A}_{\cdot,i}^{\star\top}\leq\frac{\big\|\bm{A}^{\star}\big\|_{\infty,2}^{2}}{p}\bm{A}_{\cdot,i}^{\star}\bm{A}_{\cdot,i}^{\star\top}
\]

\end_inset


\begin_inset Formula 
\[
\Rightarrow\qquad\left\Vert \sum_{i}\mathbb{E}\big[\bm{Q}_{i}\bm{Q}_{i}^{\top}\big]\right\Vert \leq\frac{\big\|\bm{A}^{\star}\big\|_{\infty,2}^{2}}{p}\big\|\bm{A}^{\star}\bm{A}^{\star\top}\big\|=\frac{\big\|\bm{A}^{\star}\big\|_{\infty,2}^{2}\big\|\bm{A}^{\star}\big\|^{2}}{p}.
\]

\end_inset

Similarly, 
\begin_inset Formula 
\[
\mathbb{E}\big[\bm{Q}_{i}^{\top}\bm{Q}_{i}\big]=\mathbb{E}\bm{Z}_{\cdot,i}\big(\bm{Z}_{\cdot,i}\big)^{\top}\big\|\bm{A}_{\cdot,i}^{\star}\big\|_{2}^{2}\leq\frac{\big\|\bm{A}^{\star}\big\|_{\infty,2}^{2}}{p}\left[A_{j,i}^{\star2}\right]_{1\leq j\leq n}
\]

\end_inset


\begin_inset Formula 
\[
\Rightarrow\qquad\sum_{i}\mathbb{E}\big[\bm{Q}_{i}\bm{Q}_{i}^{\top}\big]\leq\frac{\big\|\bm{A}^{\star}\big\|_{\infty,2}^{2}}{p}\sum_{i}\left[A_{j,i}^{\star2}\right]_{1\leq j\leq n}=\frac{\big\|\bm{A}^{\star}\big\|_{\infty,2}^{2}\big\|\bm{A}^{\star}\big\|_{2,\infty}^{2}}{p}\bm{I}.
\]

\end_inset

As a result, the variance statistics obeys
\begin_inset Formula 
\[
v=\max\left\{ \left\Vert \sum_{i}\mathbb{E}\big[\bm{Q}_{i}\bm{Q}_{i}^{\top}\big]\right\Vert ,\left\Vert \sum_{i}\mathbb{E}\big[\bm{Q}_{i}\bm{Q}_{i}^{\top}\big]\right\Vert \right\} \leq\frac{\big\|\bm{A}^{\star}\big\|_{\infty,2}^{2}\big\|\bm{A}^{\star}\big\|^{2}}{p}.
\]

\end_inset

In addition, taking 
\begin_inset Formula $L=\|\bm{A}^{\star}\|_{\infty,2}\beta_{z}$
\end_inset

 with 
\begin_inset Formula $\beta_{z}=\sqrt{\frac{\log n}{p}}\big\|\bm{A}^{\star}\big\|_{\infty,2}+\frac{\log n}{p}\big\|\bm{A}^{\star}\big\|_{\infty}$
\end_inset

, one has
\begin_inset Formula 
\[
\mathbb{P}\{\|\bm{Q}_{i}\|\leq L\}=\mathbb{P}\{\|\bm{A}_{\cdot,i}^{\star}\|_{2}\|\bm{Z}_{\cdot,i}\|_{2}\leq L\}\leq\mathbb{P}\{\|\bm{Z}_{\cdot,i}\|_{2}\leq\beta_{z}\}.
\]

\end_inset

As a result, one has
\begin_inset Formula 
\begin{align*}
\left\Vert \sum\bm{Q}_{i}\right\Vert  & \lesssim\big\|\bm{A}^{\star}\big\|_{\infty,2}\big\|\bm{A}^{\star}\big\|\sqrt{\frac{\log n}{p}}+\|\bm{A}^{\star}\|_{\infty,2}\beta_{z}\log n\\
 & \lesssim\big\|\bm{A}^{\star}\big\|_{\infty,2}\big\|\bm{A}^{\star}\big\|\sqrt{\frac{\log n}{p}}+\sqrt{\frac{\log^{3}n}{p}}\big\|\bm{A}^{\star}\big\|_{\infty,2}\|\bm{A}^{\star}\|_{\infty,2}+\frac{\log^{2}n}{p}\|\bm{A}^{\star}\|_{\infty,2}\big\|\bm{A}^{\star}\big\|_{\infty}\\
 & \lesssim\big\|\bm{A}^{\star}\big\|_{\infty,2}\big\|\bm{A}^{\star}\big\|\sqrt{\frac{\log n}{p}}+\sqrt{\frac{\log^{3}n}{p}}\big\|\bm{A}^{\star}\big\|_{\infty,2}^{2}+\|\bm{A}^{\star}\|_{\infty,2}\big\|\bm{A}^{\star}\big\|_{\infty}\frac{\log^{2}n}{p}
\end{align*}

\end_inset


\begin_inset Formula 
\[
\big\|\bm{A}^{\star}\big\|_{\infty,2}\big\|\bm{A}^{\star}\big\|\sqrt{\frac{\log^{3}n}{p}}\lesssim\sqrt{\frac{\mu^{2}r\log^{3}n}{n^{2}p}}\nu_{\max}^{2}
\]

\end_inset


\begin_inset Formula 
\[
p^{3}\leq\frac{\mu^{4}r^{3}\log^{3}n}{n^{4}}
\]

\end_inset


\end_layout

