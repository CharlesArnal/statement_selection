\[
\sqrt{\frac{\mu^{2}r\log n}{n^{2}p}}\geq\frac{\mu^{2}r\log^{2}n}{n^{2}p}\quad\rightarrow\quad p\geq\frac{\mu^{2}r\log^{3}n}{n^{2}}
\]

\end_inset


\begin_inset Formula 
\[
\frac{\mu^{1/2}\log^{0.5}n}{n^{1/2}}\leq
