\begin_layout Standard
In order to deal with the unboundedness of Gaussian random variables, we
 resort to the truncated matrix Bernstein inequality, which requires us
 to first set a proper truncation level.
 In view of the Gaussianity of 
\begin_inset Formula $\bm{a}_{i}$
\end_inset

 and the union bound, one has 
\begin_inset Formula $\|\bm{a}_{i}\|_{\infty}\leq5\sqrt{\log m}$
\end_inset

 with probability at least 
\begin_inset Formula $1-m^{-11.5}$
\end_inset

 (assuming that 
\begin_inset Formula $m\geq n$
\end_inset

).
 This in turn reveals that
\begin_inset Formula 
\[
\big\|\bm{B}_{i}\big\|=\big|a_{i,1}\big|^{2}\big\|\bm{a}_{i}\big\|_{2}^{2}\leq n\big\|\bm{a}_{i}\big\|_{\infty}^{4}\leq5n\log^{2}m
\]

\end_inset

holds with probability greater than 
\begin_inset Formula $1-m^{-11.5}$
\end_inset

.
 Therefore, taking 
\begin_inset Formula $L\coloneqq5n\log^{2}m$
\end_inset

 leads to
\begin_inset Formula 
\[
\mathbb{P}\big\{\big\|\bm{B}_{i}\big\|\geq L\big\}\leq m^{-11.5}\eqqcolon q_{0}.
\]

\end_inset

In addition, 
\end_layout

\begin_layout Standard
We then turn attention to characterizing the variance statistic.
 Towards this end, it is first seen that
\begin_inset Formula 
\begin{equation}
\mathbb{E}\big[\left(\bm{B}_{i}-\mathbb{E}[\bm{B}_{i}]\right)^{2}\big]\preceq\mathbb{E}[\bm{B}_{i}^{2}]=\mathbb{E}\big[a_{i,1}^{4}\bm{a}_{i}\bm{a}_{i}^{\top}\bm{a}_{i}\bm{a}_{i}^{\top}\big]=\mathbb{E}\big[a_{i,1}^{4}\big\|\bm{a}_{i}\big\|_{2}^{2}\bm{a}_{i}\bm{a}_{i}^{\top}\big].\label{eq:E-Bi-square-PR}
\end{equation}

\end_inset

As can be easily verified, 
\begin_inset Formula $\mathbb{E}\big[a_{i,1}^{4}\big\|\bm{a}_{i}\big\|_{2}^{2}\bm{a}_{i}\bm{a}_{i}^{\top}\big]$
\end_inset

 is a diagonal matrix, whose diagonal entries obey
\begin_inset Formula 
\[
\Big(\mathbb{E}\big[a_{i,1}^{4}\big\|\bm{a}_{i}\big\|_{2}^{2}\bm{a}_{i}\bm{a}_{i}^{\top}\big]\Big)_{l,l}=\mathbb{E}\big[a_{i,1}^{4}a_{i,l}^{4}\sum\nolimits _{j}a_{i,j}^{2}\big]=\sum\nolimits _{j}\mathbb{E}\big[a_{i,1}^{4}a_{i,l}^{4}a_{i,j}^{2}\big]\leq105n
\]

\end_inset

for any 
\begin_inset Formula $1\leq l\leq n$
\end_inset

, where the last relation follows from the property of standard Gaussian
 distributions.
 This taken together with 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:E-Bi-square-PR"
plural "false"
caps "false"
noprefix "false"

\end_inset

 gives
\begin_inset Formula 
\[
\Big\|\mathbb{E}\big[\left(\bm{B}_{i}-\mathbb{E}[\bm{B}_{i}]\right)^{2}\big]\Big\|\leq\max\nolimits _{l}\Big|\Big(\mathbb{E}\big[a_{i,1}^{4}\big\|\bm{a}_{i}\big\|_{2}^{2}\bm{a}_{i}\bm{a}_{i}^{\top}\big]\Big)_{l,l}\Big|\lesssim n
\]

\end_inset


\begin_inset Formula 
\[
\Longrightarrow\qquad v\coloneqq\Big\|\sum\nolimits _{m}\mathbb{E}\big[\left(\bm{B}_{i}-\mathbb{E}[\bm{B}_{i}]\right)^{2}\big]\Big\|\lesssim mn.
\]

\end_inset

With the above bounds in mind, invoke the truncated Bernstein inequality
 in Corollary 
\begin_inset CommandInset ref
LatexCommand ref
reference "thm:matrix-Bernstein-friendly-truncated"
plural "false"
caps "false"
noprefix "false"

\end_inset

 to yield
\begin_inset Formula 
\begin{align*}
\big\|\bm{M}-\bm{M}^{\star}\big\| & \lesssim\frac{1}{m}\sqrt{v\log m}+\frac{L}{m}\log m\\
 & \lesssim\sqrt{\frac{n\log m}{m}}+\frac{n\log^{3}m}{m}\lesssim\sqrt{\frac{n\log^{3}m}{m}},
\end{align*}

\end_inset

provided that 
\begin_inset Formula $m\gtrsim n\log^{3}m$
\end_inset

.
 
\end_layout

