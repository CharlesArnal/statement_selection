\[
\big\|\bm{A}^{\star}\big\|_{\infty}\leq\frac{\mu^{3/2}r\nu_{\max}}{n^{3/2}},~~\big\|\bm{A}^{\star}\big\|_{\infty,2}\leq\frac{\mu\sqrt{2r}\nu_{\max}}{n},~~\big\|\bm{A}^{\star}\big\|_{2,\infty}\leq\sqrt{\frac{2\mu r}{n}}\nu_{\max}.
\]

\end_inset


\begin_inset Formula 
