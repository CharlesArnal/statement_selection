\[
\mathsf{dist}\big(\bm{U},\bm{U}^{\star}\big)\lesssim\frac{\mu^{3/2}\kappa^{2}r\sqrt{\log n}}{n^{3/2}p}+\sqrt{\frac{\mu^{2}\kappa^{4}r\log n}{n^{2}p}}+\frac{\mu\kappa^{2}r}{n}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
n^{3}p\gtrsim n^{3/2}\mathrm{poly}\log(n)
\]

