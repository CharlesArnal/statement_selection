\end_layout

\begin_layout Paragraph
Step 2.1: a convenient decomposition.
\end_layout

\begin_layout Standard
We start by invoking the triangle inequality to decompose the target quantity
 as follows 
\begin_inset Formula 
\begin{align}
 & \big\|\bm{E}\big(\bm{U}\bm{H}-\bm{U}^{\star}\big)\big\|_{2,\infty}=\max_{l}\big\|\bm{E}_{l,\cdot}\big(\bm{U}\bm{H}-\bm{U}^{\star}\big)\big\|_{2}\nonumber \\
 & \leq\max_{l}\Big\{\big\|\bm{E}_{l,\cdot}\big(\bm{U}^{(l)}\bm{H}^{(l)}-\bm{U}^{\star}\big)\big\|_{2}+\big\|\bm{E}_{l,\cdot}\big(\bm{U}\bm{H}-\bm{U}^{(l)}\bm{H}^{(l)}\big)\big\|_{2}\Big\}\nonumber \\
 & \leq\max_{l}\Big\{\big\|\bm{E}_{l,\cdot}\big(\bm{U}^{(l)}\bm{H}^{(l)}-\bm{U}^{\star}\big)\big\|_{2}+\|\bm{E}\|\big\|\bm{U}\bm{H}-\bm{U}^{(l)}\bm{H}^{(l)}\big\|_{\mathrm{F}}\Big\}.\label{eq:decomposition-E-UH-Ustar}
\end{align}

\end_inset

In words, when controlling the 
\begin_inset Formula $l$
\end_inset

-th row of 
\begin_inset Formula $\bm{E}\big(\bm{U}\bm{H}-\bm{U}^{\star}\big)$
\end_inset

, we attempt to employ 
\begin_inset Formula $\bm{U}^{(l)}\bm{H}^{(l)}$
\end_inset

 as a surrogate of 
\begin_inset Formula $\bm{U}\bm{H}$
\end_inset

.
 The benefits to be harvested from this decomposition are: 
\end_layout

\begin_layout Itemize
The statistical independence between 
\begin_inset Formula $\bm{E}_{l,\cdot}$
\end_inset

 and 
\begin_inset Formula $\bm{U}^{(l)}\bm{H}^{(l)}$
\end_inset

 allows for convenient upper bounds on 
\begin_inset Formula $\big\|\bm{E}_{l,\cdot}\big(\bm{U}^{(l)}\bm{H}^{(l)}-\bm{U}^{\star}\big)\big\|_{2}$
\end_inset

;
\end_layout

\begin_layout Itemize
\begin_inset Formula $\bm{U}\bm{H}$
\end_inset

 and 
\begin_inset Formula $\bm{U}^{(l)}\bm{H}^{(l)}$
\end_inset

 are expected to be exceedingly close, so that the discrepancy incurred
 by replacing 
\begin_inset Formula $\bm{U}\bm{H}$
\end_inset

 with 
\begin_inset Formula $\bm{U}^{(l)}\bm{H}^{(l)}$
\end_inset

 is negligible.
 
