\begin_layout Standard
When it comes to 
\begin_inset Formula $\bm{E}\bm{A}$
\end_inset

, we proceed by viewing its 
\begin_inset Formula $l$
\end_inset

-th row 
\begin_inset Formula $\bm{E}_{l,\cdot}\bm{A}$
\end_inset

 as a sum of independent random vectors as follows 
\begin_inset Formula 
\[
\bm{E}_{l,\cdot}\bm{A}=\sum\nolimits _{j}E_{l,j}\bm{A}_{j,\cdot}\eqqcolon\sum\nolimits _{j}\bm{z}_{j},
\]

\end_inset

which can be controlled by the matrix Bernstein inequality.
 Specifically, it is seen from Assumption
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "assumption-noise-general"
plural "false"
caps "false"
noprefix "false"

\end_inset

 that 
\begin_inset Formula 
\begin{align*}
v & \coloneqq\sum\nolimits _{j}\mathbb{E}\big[\|\bm{z}_{j}\|_{2}^{2}\big]%=\sum_{j}\mathbb{E}\big[E_{l,j}^{2}\big]\mathbb{E}\big[\|\bm{A}_{j,\cdot}\|_{2}^{2}\big]
\leq\sigma^{2}\sum\nolimits _{j}\big\|\bm{A}_{j,\cdot}\big\|_{2}^{2}=\sigma^{2}\|\bm{A}\|_{\mathrm{F}}^{2};\\
L & \coloneqq\max_{j}\|\bm{z}_{j}\|_{2}=\max_{j}|E_{l,j}|\,\big\|\bm{Z}_{j,\cdot}\big\|_{2}\leq B\|\bm{Z}\|_{2,\infty}.
\end{align*}

\end_inset

Invoke the matrix Bernstein inequality (cf.
\begin_inset space ~
\end_inset

Corollary
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "thm:matrix-Bernstein-friendly"
plural "false"
caps "false"
noprefix "false"

\end_inset

) and take the union bound to demonstrate that: with probability exceeding
 
\begin_inset Formula $1-2n^{-6}$
\end_inset

, 
\begin_inset Formula 
\begin{align*}
\big\|\bm{E}_{l,\cdot}\bm{A}\big\|_{2} & \leq4\sqrt{v\log n}+6L\log n\leq4\sigma\sqrt{\log n}\,\|\bm{A}\|_{\mathrm{F}}+(6B\log n)\|\bm{A}\|_{2,\infty}
\end{align*}

\end_inset

holds simultaneously for all 
\begin_inset Formula $1\leq l\leq n$
\end_inset

, thus concluding the proof.
\end_layout

