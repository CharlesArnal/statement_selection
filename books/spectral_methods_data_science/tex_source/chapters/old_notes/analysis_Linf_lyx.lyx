\big\|\bm{U}\bm{H}-\bm{U}^{(l)}\bm{H}^{(l)}\big\|_{\mathrm{F}} & =\big\|\bm{U}\bm{U}^{\top}\bm{U}^{\star}-\bm{U}^{(l)}\bm{U}^{(l)\top}\bm{U}^{\star}\big\|_{\mathrm{F}}\nonumber \\
 & \leq\big\|\bm{U}\bm{U}^{\top}-\bm{U}^{(l)}\bm{U}^{(l)\top}\big\|_{\mathrm{F}}\big\|\bm{U}^{\star}\big\|\nonumber \\
 & =\big\|\bm{U}\bm{U}^{\top}-\bm{U}^{(l)}\bm{U}^{(l)\top}\big\|_{\mathrm{F}},\label{eq:UU-UlUl-UB01}
\end{align}

