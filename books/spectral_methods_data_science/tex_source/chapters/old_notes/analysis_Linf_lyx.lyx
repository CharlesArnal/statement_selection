\begin_layout Subsubsection
Step 3: bounding 
\begin_inset Formula $\|\bm{M}^{\star}(\bm{U}\bm{H}-\bm{U}^{\star})\|_{2,\infty}$
\end_inset


\end_layout

\begin_layout Standard
We make the key observation that 
\begin_inset Formula 
\begin{align}
\big\|\bm{M}^{\star}\big(\bm{U}\bm{H}-\bm{U}^{\star}\big)\big\|_{2,\infty} & =\big\|\bm{U}^{\star}\bm{\Lambda}^{\star}\bm{U}^{\star\top}\big(\bm{U}\bm{H}-\bm{U}^{\star}\big)\big\|_{2,\infty}\nonumber \\
 & \leq\big\|\bm{U}^{\star}\big\|_{2,\infty}\|\bm{\Lambda}^{\star}\|\,\big\|\bm{U}^{\star\top}\big(\bm{U}\bm{H}-\bm{U}^{\star}\big)\big\|\nonumber \\
 & =\sqrt{\frac{\mu r}{n}}\|\bm{\Lambda}^{\star}\|\,\big\|\bm{U}\bm{U}^{\top}-\bm{U}^{\star}\bm{U}^{\star\top}\big\|^{2}.\label{eq:Mstar-UH-Ustar-2-UB-123}
\end{align}

\end_inset

Here, the last identity holds true due to the following observation 
\begin_inset Formula 
\begin{align*}
\big\|\bm{U}^{\star\top}\big(\bm{U}\bm{H}-\bm{U}^{\star}\big)\big\| & =\big\|\bm{U}^{\star\top}\bm{U}\bm{U}^{\top}\bm{U}^{\star}-\bm{U}^{\star\top}\bm{U}^{\star}\big\|=\big\|\bm{U}^{\star\top}\bm{U}\bm{U}^{\top}\bm{U}^{\star}-\bm{I}\big\|\\
 & =\big\|\bm{Y}(\cos^{2}\bm{\Theta})\bm{Y}^{\top}-\bm{I}\big\|=\big\|\cos^{2}\bm{\Theta}-\bm{I}\big\|\\
 & =\big\|\sin^{2}\bm{\Theta}\big\|=\big\|\sin\bm{\Theta}\big\|^{2},
\end{align*}

\end_inset

where we denote by 
\begin_inset Formula $\bm{X}(\cos\bm{\Theta})\bm{Y}^{\top}$
\end_inset

 the SVD of 
\begin_inset Formula $\bm{U}^{\top}\bm{U}^{\star}$
\end_inset

, with 
\begin_inset Formula $\bm{X}$
\end_inset

 and 
\begin_inset Formula $\bm{Y}$
\end_inset

 being orthonormal matrices and 
\begin_inset Formula $\bm{\Theta}$
\end_inset

 the diagonal matrix consisting of the principal angles between 
\begin_inset Formula $\bm{U}$
\end_inset

 and 
\begin_inset Formula $\bm{U}^{\star}$
\end_inset

 (see the definition in
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "defn:principal-angles"
plural "false"
caps "false"
noprefix "false"

\end_inset

).
 The above bounds combined with 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:distp-U-Ustar-general"
plural "false"
caps "false"
noprefix "false"

\end_inset

 indicate that 
\begin_inset Formula 
\begin{align}
\big\|\bm{M}^{\star}\big(\bm{U}\bm{H}-\bm{U}^{\star}\big)\big\|_{2,\infty} & \leq%\big|\lambda_{1}^{\star}\big|\sqrt{\frac{\mur}{n}}\,\frac{4c_{2}^{2}\sigma^{2}n}{\big(\lambda_{r}^{\star}\big)^{2}}
\big|\lambda_{1}^{\star}\big|\sqrt{\frac{\mu r}{n}}\,\big\|\sin\bm{\Theta}\big\|^{2}%=\big|\lambda_{1}^{\star}\big|\sqrt{\frac{\mur}{n}}\,\big\|\sin\bm{\Theta}\big\|^{2}
\nonumber \\
 & \leq\frac{4c_{2}^{2}\kappa\sigma^{2}\sqrt{\mu rn}}{\lambda_{r}^{\star}}\eqqcolon\alpha_{2}.\label{eq:Mstar-UH-Ustar-2inf}
\end{align}

\end_inset


\end_layout

\begin_layout Subsubsection
Step 4: putting all pieces together
\end_layout

\begin_layout Standard
Combining the bounds 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:El-UH-Ustar-UB-Bern123"
plural "false"
caps "false"
noprefix "false"

\end_inset

 and 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:Mstar-UH-Ustar-2inf"
plural "false"
caps "false"
noprefix "false"

\end_inset

 in Steps 2-3 and using the definition of 
\begin_inset Formula $\mathcal{E}_{1}$
\end_inset

 give 
\begin_inset Formula 
\begin{align}
\mathcal{E}_{1} & \leq\frac{2\big\|\bm{E}\big(\bm{U}\bm{H}-\bm{U}^{\star}\big)\big\|_{2,\infty}+2\big\|\bm{M}^{\star}\big(\bm{U}\bm{H}-\bm{U}^{\star}\big)\big\|_{2,\infty}}{\lambda_{r}^{\star}}\nonumber \\
 & \leq\mathcal{E}_{1,1}+\rho_{1}\|\bm{U}\bm{H}-\bm{U}^{\star}\|_{2,\infty},\label{eq:E1-UB-general-1}
\end{align}

\end_inset

where 
\begin_inset Formula 
\begin{equation}
\mathcal{E}_{1,1}\coloneqq\frac{2\big(\alpha_{0}+\alpha_{1}+\alpha_{2}\big)}{\lambda_{r}^{\star}}\quad\text{and}\quad\rho_{1}\coloneqq\frac{2c_{4}(\sigma\sqrt{n}+B\log n)}{\lambda_{r}^{\star}}.\label{eq:defn-E1-rho1}
\end{equation}

\end_inset

This matches precisely the relation hypothesized in 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:E1-UB-E11-rho1"
plural "false"
caps "false"
noprefix "false"

\end_inset

.
 In particular, one has 
\begin_inset Formula $0<\rho\leq1/2$
\end_inset

 as long as 
\begin_inset Formula $4c_{4}(\sigma\sqrt{n}+B\log n)\leq\lambda_{r}^{\star}$
\end_inset

.
\end_layout

\begin_layout Standard
Recall that 
\begin_inset Formula $\mathcal{E}_{1,1}$
\end_inset

, 
\begin_inset Formula $\mathcal{E}_{2}$
\end_inset

, 
\begin_inset Formula $\mathcal{E}_{3}$
\end_inset

, 
