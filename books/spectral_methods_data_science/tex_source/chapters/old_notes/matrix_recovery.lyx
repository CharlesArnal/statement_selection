\begin_layout Paragraph
The matrix Bernstein inequality.
\end_layout

\begin_layout Standard
The first result is the matrix Bernstein inequality 
\begin_inset ERT
status collapsed

\begin_layout Plain Layout

\backslash
citep{tropp2012user}
\end_layout

\end_inset

, an elegant and convenient-to-use tail bound that leads to effective performance guarantees for a wide range of statistical applications. 
\begin_inset ERT
status collapsed

\begin_layout Plain Layout

\backslash
begin{theorem}[Matrix Bernstein]
\end_layout

\end_inset

 
\begin_inset CommandInset label
LatexCommand label
name "thm:matrix-Bernstein"

\end_inset

 Let 
\begin_inset Formula $\{\bm{X}_{i}\}$
\end_inset

 be a sequence of independent real random matrices with dimension 
\begin_inset Formula $n_{1}\times n_{2}$
\end_inset

. Suppose that 
\begin_inset Formula \begin{align}
\mathbb{E}\left[\bm{X}_{i}\right]=\bm{0} 
	\quad \text{and} \quad
	\left\Vert \bm{X}_{i}\right\Vert \leq B\qquad\text{for all } i.
	\label{eq:mean-zero-bound-B}
\end{align}
\end_inset

Define the matrix variance statistic 
\begin_inset Formula $v$
\end_inset

 as follows 
\begin_inset Formula \begin{align}
	v \coloneqq
	\max\left\{ \left\Vert \sum\nolimits_{i}\mathbb{E}\big[\bm{X}_{i}\bm{X}_{i}^{\top}\big]\right\Vert ,
	\left\Vert \sum\nolimits_{i}\mathbb{E}\big[\bm{X}_{i}^{\top}\bm{X}_{i}\big]\right\Vert \right\} .
	\label{defn:variance-statistic}
\end{align}
\end_inset

Then for all 
\begin_inset Formula $t\geq0$
\end_inset

, one has 
\begin_inset Formula \[
	\mathbb{P}\left( \left\Vert \sum\nolimits_{i}\bm{X}_{i}\right\Vert \geq t\right)\leq\left(n_{1}+n_{2}\right) \exp\left(\frac{-t^{2}/2}{v+Bt/3}\right).
\]
\end_inset


\begin_inset ERT
status collapsed

\begin_layout Plain Layout

\backslash
end{theorem}
\end_layout

\end_inset


\end_layout

