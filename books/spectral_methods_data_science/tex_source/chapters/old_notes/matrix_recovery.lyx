\backslash
end{theorem}
\end_layout

\end_inset


\end_layout

\begin_layout Standard

\begin_inset ERT
status collapsed

\begin_layout Plain Layout

\backslash
begin{theorem}[Matrix completion: recovered matrix]
\end_layout

\end_inset

Suppose that 
\begin_inset Formula $n_{2}p\geq C\mu r\log n_{2}$
\end_inset

 for some sufficiently large constant 
\begin_inset Formula $C>0$
\end_inset

. Then with probability at least 
\begin_inset Formula $1-O(n_{2}^{-10})$
\end_inset

, one has 
\begin_inset Formula \begin{align*}
\|\bm{U}\bm{\Sigma}\bm{V}^{\top}-\bm{M}^{\star}\| & \lesssim\sqrt{\frac{\mu r}{n_{1}p}\log n_{2}}\,\sigma_{1}(\bm{M}^{\star});\\
\|\bm{U}\bm{\Sigma}\bm{V}^{\top}-\bm{M}^{\star}\|_{\mathrm{F}} & \lesssim\sqrt{\frac{\mu r^{2}}{n_{1}p}\log n_{2}}\,\sigma_{1}(\bm{M}^{\star}).
\end{align*}
\end_inset


