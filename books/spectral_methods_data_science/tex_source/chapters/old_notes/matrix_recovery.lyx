reference "def:BD-mu"
plural "false"
caps "false"
noprefix "false"

\end_inset

 with parameter 
\begin_inset Formula $\mu$
\end_inset

, and assume 
\begin_inset Formula $\|\vhp\|_2=\|\bm{x}_{\star}\|_2$
\end_inset

. For any 
\begin_inset Formula $\zeta > 0$
\end_inset

, if 
\begin_inset Formula $m \ge c_0 \zeta^{-2} \mu^2 K \log^2 m $
\end_inset

 for some sufficiently large constant 
\begin_inset Formula $c_0 > 0$
\end_inset

, then the spectral estimate 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:init-BD"
plural "false"
caps "false"
noprefix "false"

\end_inset

 obeys 
\begin_inset Formula \[
	\min_{\alpha \in \C, \abs{\alpha} = 1} \big\{ \| \alpha \vh_0 - \vhp \|_2 + \| \alpha \vx_0 - \vxp\|_2 \big\}  \le \zeta \|\vhp\|_2
\]
