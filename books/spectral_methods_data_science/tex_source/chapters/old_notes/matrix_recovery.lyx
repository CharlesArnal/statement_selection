 Given that Gaussian entries are unbounded, we introduce a truncated copy 
\begin_inset Formula $\widetilde{\bm{E}}=[\widetilde{E}_{i,j}]_{1\leq i,j\leq n}$
\end_inset

 defined as follows 
\begin_inset Formula \begin{equation}
\widetilde{E}_{i,j}\coloneqq E_{i,j}\ind\big\{|E_{i,j}|\leq 5\sigma\sqrt{\log n}\big\}, \qquad 1\leq i,j\leq n.
	\label{eq:defn-Eij-truncated-denoising}
\end{equation}
\end_inset

Two properties are worth mentioning. 
\end_layout

\begin_layout Itemize
It is readily seen from the property of Gaussian distributions that 
\begin_inset Formula \[
\mathbb{P}\big\{ E_{i,j}=\widetilde{E}_{i,j}\big\}\geq1-n^{-12},\qquad1\leq i,j\leq n,
\]
\end_inset

which combined with the union bound leads to 
\begin_inset Formula \begin{equation}
\mathbb{P}\big\{\bm{E}=\widetilde{\bm{E}}\big\}\geq1-n^{-10}.\label{eq:prob-E-Etilde-equivalence-denoising}
\end{equation}
\end_inset


\end_layout

\begin_layout Itemize
Given that 
\begin_inset Formula $B\coloneqq\max_{i,j}|\widetilde{E}_{i,j}|\leq 5\sigma\sqrt{\log n}$
\end_inset

, we can invoke Theorem 
\begin_inset CommandInset ref
LatexCommand ref
reference "thm:tighter-spectral-normal-ramon"
plural "false"
caps "false"
noprefix "false"

\end_inset

 (or more directly, (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:X-spectral-norm-iid-special-ramon"
plural "false"
caps "false"
noprefix "false"

\end_inset

)) to demonstrate that 
\begin_inset Formula \[
\|\widetilde{\bm{E}}\|\leq4\sigma\sqrt{n}+O(B\log n)=4\sigma\sqrt{n}+O(\sigma\log^{1.5}n)\leq5\sigma\sqrt{n}
\]
\end_inset

with probability exceeding 
\begin_inset Formula $1-O(n^{-8})$
\end_inset

. 
\end_layout

\begin_layout Standard
Combining the above two observations implies that 
\begin_inset Formula \[
\|\bm{E}\|=\|\widetilde{\bm{E}}\|\leq5\sigma\sqrt{n}
\]
\end_inset

with probability exceeding 
\begin_inset Formula $1-O(n^{-8})$
\end_inset

, as claimed. 
