\end_layout

\begin_layout Enumerate
Another way to take care of the rotation ambiguity is to consider the Procrustes
 problem 
\begin_inset Formula 
\[
\mathsf{minimize}_{\bm{R}\in\mathcal{O}^{r\times r}}\quad\left\Vert \bm{U}\bm{R}-\bm{V}\right\Vert _{\mathrm{F}}^{2},
\]

\end_inset

whose solution is revealed in the SVD of 
\begin_inset Formula $\bm{U}^{\top}\bm{V}$
\end_inset

.
 More precisely, let 
\begin_inset Formula $\bm{X}\bm{\Sigma}\bm{Y}^{\top}$
\end_inset

 be the SVD of 
\begin_inset Formula $\bm{U}^{\top}\bm{V}$
\end_inset

, then one has 
\begin_inset Formula 
\[
\bm{X}\bm{Y}^{\top}=\arg\min_{\bm{R}\in\mathcal{O}^{r\times r}}\quad\left\Vert \bm{U}\bm{R}-\bm{V}\right\Vert _{\mathrm{F}}^{2}.
\]

\end_inset

The quantity of interest to us is 
\begin_inset Formula $\bm{\Sigma}$
\end_inset

.
 Denote by 
\begin_inset Formula $(\sigma_{1},\sigma_{2},\cdots\sigma_{r})$
\end_inset

 the entries in 
\begin_inset Formula $\bm{\Sigma}$
\end_inset

 in decreasing order.
 As a result, we define and arrange them into
\end_layout

\begin_deeper
\begin_layout Plain Layout
Several immediate facts are in order.
 First 
\begin_inset Formula 
\[
\left\Vert \bm{U}\bm{R}-\bm{V}\right\Vert =\bm{U}\bm{X}\bm{Y}^{\top}-\bm{V}
\]

\end_inset

First 
\begin_inset Formula 
\[
\left\Vert \sin\bm{\Theta}\right\Vert _{\mathrm{F}}^{2}=\sum_{i=1}^{r}\left(\sin\theta_{r}\right)^{2}=\sum_{i=1}^{r}\left[1-\left(\cos\theta_{r}\right)^{2}\right]=r-\left\Vert \bm{\Sigma}\right\Vert _{\mathrm{F}}^{2}.
\]

\end_inset

Second, one has 
\begin_inset Formula 
\begin{align*}
\left\Vert \bm{U}\bm{X}\bm{Y}^{\top}-\bm{V}\right\Vert _{\mathrm{F}}^{2} & =\left\Vert \bm{U}\right\Vert _{\mathrm{F}}^{2}+\left\Vert \bm{V}\right\Vert _{\mathrm{F}}^{2}-2\mathsf{Tr}\left(\bm{Y}\bm{X}^{\top}\bm{U}^{\top}\bm{V}\right)\\
 & =2r-2\mathsf{Tr}\left(\bm{Y}\bm{X}^{\top}\bm{X}\bm{\Sigma}\bm{Y}^{\top}\right)\\
 & =2r-2\mathsf{Tr}\left(\bm{\Sigma}\right)\\
 & \leq2r-2\sum_{i=1}^{r}\sigma_{i}^{2}\\
 & =2\left\Vert \sin\bm{\Theta}\right\Vert _{\mathrm{F}}^{2}.
\end{align*}

\end_inset


\end_layout

\end_deeper
\end_inset


\end_layout

