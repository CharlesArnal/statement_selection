begin{lemma}[
\end_layout

\end_inset

Wely's inequality for singular values
\begin_inset ERT
status open

\begin_layout Plain Layout

]
\end_layout

\end_inset


\begin_inset CommandInset label
LatexCommand label
name "lemma:weyls-singular-value"

\end_inset

Let 
\begin_inset Formula $\bm{A},\bm{E}\in\mathbb{R}^{m\times n}$
\end_inset

 be two general matrices.
 Without loss of generality, assume that 
\begin_inset Formula $m\leq n$
\end_inset

.
 Then for every 
\begin_inset Formula $1\leq i\leq m$
\end_inset

, one has 
\begin_inset Formula 
\[
\left|\sigma_{i}\left(\bm{A}+\bm{E}\right)-\sigma_{i}\left(\bm{A}\right)\right|\leq\left\Vert \bm{E}\right\Vert .
\]

\end_inset


\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
end{lemma}
\end_layout

\end_inset


\end_layout

