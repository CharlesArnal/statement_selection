\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{theorem}[
\end_layout

\end_inset

Bernstein's inequality
\begin_inset ERT
status open

\begin_layout Plain Layout

]
\end_layout

\end_inset

Let 
\begin_inset Formula $\{x_{i}\}_{1\leq i\leq n}$
\end_inset

 be a sequence of independent random variables.
 Suppose that for each 
\begin_inset Formula $1\leq i\leq n$
\end_inset

, 
\begin_inset Formula $\mathbb{E}[x_{i}]=0$
\end_inset

 and 
\begin_inset Formula $|x_{i}|\leq B$
\end_inset

 almost surely.
 Then we have for all 
\begin_inset Formula $t\geq0$
\end_inset

 
\begin_inset Formula 
\[
\mathbb{P}\left(\left|\sum_{i=1}^{n}x_{i}\right|\geq t\right)\leq2\exp\left(\frac{-t^{2}/2}{V+Bt/3}\right),
\]

\end_inset

where 
\begin_inset Formula $V$
\end_inset

 is the variance statistic 
\begin_inset Formula 
\[
V\triangleq\left|\sum_{i=1}^{n}\mathbb{E}\left[x_{i}^{2}\right]\right|.
\]

\end_inset


\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
end{theorem}
\end_layout

\end_inset


\end_layout

\begin_layout Standard
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
begin{theorem}[
\end_layout

\end_inset

Matrix Bernstein's inequality
\begin_inset ERT
status open

\begin_layout Plain Layout

]
\end_layout

\end_inset

Let 
\begin_inset Formula $\{\bm{X}_{i}\}_{1\leq i\leq n}$
\end_inset

 be a sequence of independent real random matrices with dimension 
\begin_inset Formula $d_{1}\times d_{2}$
\end_inset

.
 Suppose that 
\begin_inset Formula 
\[
\mathbb{E}\left[\bm{X}_{i}\right]=\bm{0},\qquad\left\Vert \bm{X}_{l}\right\Vert \leq B\qquad\text{for each }i.
\]

\end_inset

Let 
\begin_inset Formula $V$
\end_inset

 be the variance statistic
\begin_inset Formula 
\[
V\triangleq\max\left\{ \left\Vert \sum_{i=1}^{n}\mathbb{E}\left[\bm{X}_{i}\bm{X}_{i}^{\top}\right]\right\Vert ,\left\Vert \sum_{i=1}^{n}\mathbb{E}\left[\bm{X}_{i}^{\top}\bm{X}_{i}\right]\right\Vert \right\} .
\]

\end_inset

Then one has for all 
\begin_inset Formula $t\geq0$
\end_inset

, 
\begin_inset Formula 
\[
\mathbb{P}\left(\left\Vert \sum_{i=1}^{n}\bm{X}_{i}\right\Vert \geq t\right)\leq\left(d_{1}+d_{2}\right)\exp\left(\frac{-t^{2}/2}{V+Bt/3}\right).
\]

\end_inset


\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
end{theorem}
\end_layout

\end_inset

,
\end_layout

